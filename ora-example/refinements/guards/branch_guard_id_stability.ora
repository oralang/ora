// Branch guard_id stability test
// Each branch retains its own source-bound conversion guard.
// The positive input contract establishes the shared bound.

contract GuardIdStability {
    pub fn branch_guard(flag: bool, x: u256) -> u256
        requires(x >= 10)
    {
        var out: u256 = 0;

        if (flag) {
            let y: MinValue<u256, 10> = x;
            out = y;
        } else {
            let y: MinValue<u256, 10> = x;
            out = y;
        }

        return out;
    }
}
