// Deliberate invalid-conversion runtime fixture.
// Default verification rejects this file: literal zero and unconstrained address
// values cannot be proved nonzero. It is not a verified-positive example.
// With --no-verify, conversion/input checks remain and must reject zero at runtime.
// runtimeNonZeroAddress is the checked-input positive control.

contract NonZeroAddressRuntime {
    pub fn runtimeNonZeroAddress(addr: NonZeroAddress) {
        let owner: NonZeroAddress = addr;
    }

    // Historical name: this uses a local zero, not a storage read.
    pub fn runtimeNonZeroFromStorage() {
        var stored_addr: address = 0x0;
        let owner: NonZeroAddress = stored_addr;
    }

    pub fn getAddress() -> address {
        var addr: address = 0x0;
        return addr;
    }

    pub fn testCall() {
        let addr: address = getAddress();
        let owner: NonZeroAddress = addr;
    }

    pub fn runtimeNonZeroFromAddressParam(addr: address) {
        let owner: NonZeroAddress = addr;
    }

    // Retained no-op control; it makes no address-arithmetic claim.
    pub fn runtimeNonZeroFromArithmetic(x: address, y: address) {
    }
}
