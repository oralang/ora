// INPUT: tests/conformance/compound_arithmetic.ora
// The overflow guard must consume the same source-width sum as the payload.
// CHECK-LABEL: fn narrow_add8:
// CHECK: [[W8_ADD_MASK:v[0-9]+]] = const 0xFF
// CHECK: [[W8_ADD_RHS:v[0-9]+]] = and v1 [[W8_ADD_MASK]]
// CHECK: [[W8_ADD_LHS:v[0-9]+]] = and v0 [[W8_ADD_MASK]]
// CHECK: [[W8_ADD_SUM:v[0-9]+]] = add [[W8_ADD_LHS]] [[W8_ADD_RHS]]
// CHECK-NEXT: [[W8_ADD_NARROW:v[0-9]+]] = and [[W8_ADD_SUM]] [[W8_ADD_MASK]]
// CHECK-NEXT: [[W8_ADD_GT:v[0-9]+]] = gt [[W8_ADD_NARROW]] [[W8_ADD_LHS]]
// CHECK-NEXT: [[W8_ADD_EQ:v[0-9]+]] = eq [[W8_ADD_NARROW]] [[W8_ADD_LHS]]
// CHECK-NEXT: [[W8_ADD_SAFE:v[0-9]+]] = or [[W8_ADD_GT]] [[W8_ADD_EQ]]
// CHECK-NEXT: => [[W8_ADD_SAFE]] ?
// CHECK: revert
