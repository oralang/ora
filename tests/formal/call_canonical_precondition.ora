error RejectedCall(value: u256);
contract CallCanonicalPrecondition {
    fn checked(x: u256) -> !u256 | RejectedCall requires x < 2 {
        return RejectedCall(x);
    }
    pub fn run() -> !u256 | RejectedCall {
        var i: u256 = 0;
        while (i < 1) invariant i <= 1 { i = i +% 1; }
        let selected: u256 = try checked(2);
        return selected;
    }
}
