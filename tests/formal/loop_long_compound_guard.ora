contract LongCompoundGuard {
    pub fn run(limit: u256) -> u256
    requires limit <= 4
    {
        var i: u256 = 0;
        while (i < limit && i < 4 && i < 5 && i < 6 &&
               i < 7 && i < 8 && i < 9 && i < 10 &&
               i < 11 && i < 12 && i < 13 && i < 14 &&
               i < 15 && i < 16 && 12 / (i + 1) > 0)
        invariant i <= limit
        {
            i = i + 1;
        }
        return i;
    }
}
