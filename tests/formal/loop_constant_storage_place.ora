contract ConstantStoragePlace {
    storage var values: [u256; 4];

    pub fn preserve(write_index: u256, value: u256)
    requires(write_index < 4)
    requires(write_index != 0)
    {
        var i: u256 = 0;
        while (i < 1)
        invariant(values[0] == old(values[0]))
        {
            values[write_index] = value;
            i = i +% 1;
        }
    }

    pub fn clobber(write_index: u256, value: u256)
    requires(write_index < 4)
    {
        var i: u256 = 0;
        while (i < 1)
        invariant(values[0] == old(values[0]))
        {
            values[write_index] = value;
            i = i +% 1;
        }
    }
}
