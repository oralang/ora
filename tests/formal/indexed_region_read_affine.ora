contract IndexedRegionReadAffine {
    storage var output: [u256; 32];

    pub fn copy(input: slice[u256], count: u256)
        requires count <= input.len
        requires count <= 28
    {
        var i: u256 = 0;
        while (i < count)
            invariant i <= count
        {
            output[4 + i] = input[i];
            i = i + 1;
        }
    }
}
