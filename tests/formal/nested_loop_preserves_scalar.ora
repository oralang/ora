contract NestedLoopPreservesScalar {
    pub fn run() -> u256 {
        var outer: u256 = 0;
        var total: u256 = 0;

        while (outer < 2)
            invariant outer <= 2
            invariant total == 0
        {
            var inner: u256 = 0;
            var bound: u256 = 3;
            while (inner < bound)
                invariant inner <= bound
                invariant bound == 3
            {
                inner = inner + 1;
                bound = bound;
            }

            outer = outer + 1;
        }

        return total;
    }
}
