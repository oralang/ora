contract NestedLoopDependencySafety {
    pub fn run() -> u256 {
        var outer: u256 = 0;
        var total: u256 = 0;

        while (outer < 2)
            invariant outer <= 2
        {
            total = 0;
            var inner: u256 = 0;
            while (inner < 3)
                invariant inner <= 3
            {
                inner = inner + 1;
            }

            total = total + inner;
            outer = outer + 1;
        }

        return total;
    }
}
