contract FailDirectStoragePreheaderFalseInvariant {
    storage var counter: u256 = 0;

    pub fn contradict()
        modifies counter
    {
        counter = counter;
        var i: u256 = 0;
        while (i < 1)
            invariant counter != old(counter)
        {
            i = i;
        }
    }
}
