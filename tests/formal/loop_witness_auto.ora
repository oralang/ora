contract LoopWitnessAuto {
    storage var observed: u256;

    pub fn narrow(limit: u32) -> u32
    requires 2 <= limit
    requires limit < 5
    {
        var i: u32 = 0;
        while (i < limit)
        invariant i <= limit
        {
            i = i + 1;
        }
        return i;
    }

    pub fn mixed(limit: u256, extra: u256)
    requires limit >= 1
    requires limit <= 4
    {
        var i: u256 = 0;
        while (i < limit)
        invariant i <= limit
        {
            observed = extra;
            i = i + 1;
        }
    }

    pub fn fallthrough(limit: u256) -> u256
    requires limit >= 1
    {
        if (limit > 4) {
            return 0;
        }
        var i: u256 = 0;
        while (i < limit)
        invariant i <= 4
        {
            i = i + 1;
        }
        return i;
    }
}
