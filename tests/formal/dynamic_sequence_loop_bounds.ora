contract DynamicSequenceLoopBounds {
    pub fn scan(values: slice[u256]) {
        var i: u256 = 0;
        while (i < values.len)
            invariant i <= values.len
        {
            let observed: u256 = values[i];
            i = i +% 1;
        }
    }

    pub fn scanBytes(values: bytes) {
        var i: u256 = 0;
        while (i < values.len)
            invariant i <= values.len
        {
            let observed: u8 = values[i];
            i = i +% 1;
        }
    }

    pub fn scanString(values: string) {
        var i: u256 = 0;
        while (i < values.len)
            invariant i <= values.len
        {
            let observed: u8 = values[i];
            i = i +% 1;
        }
    }
}
