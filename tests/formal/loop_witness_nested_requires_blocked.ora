// Existing planner boundary, not a witness failure: the child's inherited
// function assumptions have no matching same-block header-fact rows.
contract LoopWitnessNestedRequiresBlocked {
    pub fn run(limit: u256) -> u256
    requires limit >= 1
    requires limit <= 4
    {
        var outer: u256 = 0;
        while (outer < limit)
        invariant outer <= limit
        {
            var inner: u256 = 0;
            while (inner < 2)
            invariant inner <= 2
            {
                inner = inner + 1;
            }
            outer = outer + 1;
        }
        return outer;
    }
}
