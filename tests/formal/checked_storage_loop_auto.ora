contract CheckedStorageLoopAuto {
    storage var first: [u256; 4];
    storage var second: [u256; 4];

    pub fn oneWrite() {
        var i: u256 = 0;
        while (i < 4)
            invariant i <= 4
        {
            first[i] = i;
            i = i + 1;
        }
    }

    pub fn twoWrites() {
        var i: u256 = 0;
        while (i < 4)
            invariant i <= 4
        {
            first[i] = i;
            second[i] = i;
            i = i + 1;
        }
    }

}
