contract StorageLoopProjection {
    storage var counter: u256 = 0;
    storage var left: u256 = 0;
    storage var right: u256 = 0;
    storage var signed_value: i8 = 0;

    pub fn readThenWrite(n: u256)
        requires n <= 3
        modifies counter
    {
        var i: u256 = 0;
        while (i < n)
            invariant i <= n
        {
            counter = counter + 1;
            i = i + 1;
        }
    }

    pub fn divideFromStorage(n: u256)
        requires n <= 3
        modifies left
    {
        var i: u256 = 0;
        while (i < n)
            invariant i <= n
        {
            let divisor: u256 = counter;
            left = 10 / divisor;
            i = i + 1;
        }
    }

    pub fn writeThenRead(n: u256)
        requires n <= 3
        modifies counter
    {
        var i: u256 = 0;
        while (i < n)
            invariant i <= n
        {
            counter = i;
            let observed: u256 = counter;
            counter = observed;
            i = i + 1;
        }
    }

    pub fn repeatedWrite(n: u256)
        requires n <= 3
        modifies left, right
    {
        var i: u256 = 0;
        while (i < n)
            invariant i <= n
        {
            left = i;
            let next: u256 = i + 1;
            right = next;
            i = next;
        }
    }

    pub fn branchWrite(n: u256)
        requires n <= 3
        modifies left, right
    {
        var i: u256 = 0;
        while (i < n)
            invariant i <= n
        {
            if (i == 0) {
                left = i;
            } else {
                right = i;
            }
            i = i + 1;
        }
    }

    pub fn zeroIteration()
        modifies counter
    {
        var i: u256 = 0;
        while (i < 0)
            invariant i == 0
        {
            counter = i;
            i = i + 1;
        }
    }

    pub fn signedWrite(n: u8)
        requires n <= 2
        modifies signed_value
    {
        var i: u8 = 0;
        while (i < n)
            invariant i <= n
        {
            signed_value = -1;
            i = i + 1;
        }
    }
}
