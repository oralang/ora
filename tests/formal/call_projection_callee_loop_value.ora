contract CalleeLoopValue {
    fn repeat(limit: u256) -> u256 requires limit <= 2 ensures result <= limit {
        var i: u256 = 0;
        while (i < limit) invariant i <= limit { i = i +% 1; }
        return i;
    }
    pub fn run(limit: u256) -> u256 requires limit <= 2 ensures result <= limit { return repeat(limit); }
}
