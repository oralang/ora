contract LoopStructuredCli {
    pub fn countTo(n: u256) -> u256
        requires n <= 4
    {
        var i: u256 = 0;

        while (i < n)
            invariant i <= n
        {
            if (i < 2) {
                i = i +% 1;
            } else {
                i = i +% 1;
            }
        }

        return i;
    }
}
