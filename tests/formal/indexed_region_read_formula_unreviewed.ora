contract IndexedRegionReadFormulaUnreviewed {
    pub fn copy(input: slice[u256], count: u256)
        requires count <= input.len
    {
        var i: u256 = 0;
        var value: u256 = 0;
        while (i < count)
            invariant i <= count
        {
            value = input[i];
            i = i + 1;
        }
    }
}
