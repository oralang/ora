contract StorageLoopClosureAuto {
    storage var counter: u256;
    storage var mirror: u256;

    pub fn writeBeforeRead() {
        var i: u256 = 0;
        while (i < 1)
            invariant i <= 1
        {
            counter = i;
            let observed: u256 = counter;
            counter = observed;
            i = i +% 1;
        }
    }

    pub fn repeatedWrite() {
        var i: u256 = 0;
        while (i < 1)
            invariant i <= 1
        {
            counter = i;
            counter = i +% 1;
            i = i +% 1;
        }
    }

    pub fn distinctRoots() {
        var i: u256 = 0;
        while (i < 1)
            invariant i <= 1
        {
            counter = i;
            mirror = counter;
            i = i +% 1;
        }
    }

    pub fn zeroIteration() {
        var i: u256 = 0;
        while (i < 0)
            invariant i == 0
        {
            counter = i;
            i = i +% 1;
        }
    }
}
